# Example environment variables for local development
# Copy this file to `.env` and fill in real secret values locally.

# Database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT for application authentication
JWT_SECRET=replace_with_a_strong_jwt_secret

# Groq (OpenAI-compatible) API key for FarmVerse AI
GROQ_API_KEY=your_groq_api_key

# Weather API key (e.g., WeatherAPI or OpenWeatherMap)
WEATHERAPI_API_KEY=your_weatherapi_api_key

# Optional: server port override (if you want to run on different port)
#SERVER_PORT=8085
